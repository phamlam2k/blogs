<mxfile host="drawio"><diagram name="03-srcset-selection" id="03-srcset-selection"><mxGraphModel dx="900" dy="440" grid="1" gridSize="10" guides="1" page="0" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="A phone: viewport 390px, device pixel ratio 3" style="text;html=0;strokeColor=none;fillColor=none;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=17;fontColor=#24292F;align=center;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="860" height="30" as="geometry"/></mxCell><mxCell id="c2" value="① Match sizes (first match wins)&#xa;(min-width: 1024px) 400px  ✗&#xa;(min-width: 640px) 50vw  ✗&#xa;100vw  ✓  → slot = 390px" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=14;fillColor=#DDF4FF;strokeColor=#0969DA;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="270" height="130" as="geometry"/></mxCell><mxCell id="c3" value="② Multiply by DPR&#xa;390px × 3&#xa;= 1170 pixels needed" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=14;fillColor=#DDF4FF;strokeColor=#0969DA;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="240" height="130" as="geometry"/></mxCell><mxCell id="c4" value="③ Pick from srcset&#xa;the smallest file&#xa;that is at least 1170px wide" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=14;fillColor=#DDF4FF;strokeColor=#0969DA;" vertex="1" parent="1"><mxGeometry x="610" y="50" width="270" height="130" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#57606A;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#57606A;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c7" value="card-400.jpg  (400w)&#xa;too small" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=14;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontColor=#8C959F;" vertex="1" parent="1"><mxGeometry x="20" y="240" width="200" height="80" as="geometry"/></mxCell><mxCell id="c8" value="card-800.jpg  (800w)&#xa;too small" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=14;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontColor=#8C959F;" vertex="1" parent="1"><mxGeometry x="245" y="240" width="200" height="80" as="geometry"/></mxCell><mxCell id="c9" value="card-1200.jpg  (1200w)&#xa;✓ chosen" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=14;fontStyle=1;fillColor=#DAFBE1;strokeColor=#1A7F37;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="200" height="80" as="geometry"/></mxCell><mxCell id="c10" value="card-1600.jpg  (1600w)&#xa;more than needed" style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=14;fillColor=#FFFFFF;strokeColor=#D0D7DE;fontColor=#8C959F;" vertex="1" parent="1"><mxGeometry x="695" y="240" width="185" height="80" as="geometry"/></mxCell><mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=0;endArrow=block;endFill=1;strokeColor=#1A7F37;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c4" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c12" value="No sizes attribute? The browser assumes 100vw.&#xa;On a 1440px laptop at 2× that is 2880px needed → it downloads the biggest file every time." style="rounded=1;arcSize=12;whiteSpace=nowrap;html=0;fontFamily=Helvetica;fontSize=14;fontColor=#24292F;fontSize=14;fillColor=#FFEBE9;strokeColor=#CF222E;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="860" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
