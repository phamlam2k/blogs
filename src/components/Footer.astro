---
import { SITE, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <span class="muted">© {year} {SITE.author}</span>
    <span class="links">
      <a href="/rss.xml">RSS</a>
      {SOCIALS.github && <a href={SOCIALS.github} rel="me noopener" target="_blank">GitHub</a>}
      {SOCIALS.linkedin && <a href={SOCIALS.linkedin} rel="me noopener" target="_blank">LinkedIn</a>}
      {SOCIALS.email && <a href={`mailto:${SOCIALS.email}`}>Email</a>}
    </span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  .links a {
    color: var(--fg-muted);
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
