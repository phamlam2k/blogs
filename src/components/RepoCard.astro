---
import { render } from 'astro:content';
import type { Repo } from '../utils/content';
import TopicBadge from './TopicBadge.astro';
import TagList from './TagList.astro';

interface Props {
  repo: Repo;
  compact?: boolean;
}
const { repo, compact = false } = Astro.props;
const { name, url, description, language, topic, tags, mine } = repo.data;
const { Content } = await render(repo);
const hasNote = (repo.body ?? '').trim().length > 0;
---

<article class="repo">
  <header>
    <svg class="gh" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.25.25 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"></path></svg>
    <a href={url} target="_blank" rel="noopener" class="name">{name}</a>
    {mine && <span class="mine">[mine]</span>}
  </header>
  <p class="desc">{description}</p>
  {!compact && hasNote && (
    <div class="note">
      <Content />
    </div>
  )}
  <footer>
    {language && <span class="lang"><span class="dot" />{language}</span>}
    <TopicBadge topic={topic} />
    <TagList tags={tags} />
  </footer>
</article>

<style>
  .repo {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    background: var(--bg-soft);
  }
  header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gh {
    color: var(--fg-muted);
    flex-shrink: 0;
  }
  .name {
    font-weight: 700;
    word-break: break-all;
  }
  .mine {
    color: var(--accent);
    font-size: 0.8rem;
  }
  .desc {
    margin: 0.4rem 0;
    font-size: 0.9rem;
  }
  .note {
    font-size: 0.88rem;
    color: var(--fg-muted);
    border-left: 2px solid var(--accent);
    padding-left: 0.75rem;
    margin: 0.5rem 0;
  }
  .note :global(p) {
    margin: 0.3rem 0;
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    align-items: baseline;
    font-size: 0.82rem;
  }
  .lang {
    color: var(--fg-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
  }
</style>
