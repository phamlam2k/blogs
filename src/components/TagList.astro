---
interface Props {
  tags: string[];
  counts?: Map<string, number>;
}
const { tags, counts } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>
          <a href={`/labels/${tag}/`}>
            #{tag}
            {counts && <span class="count">{counts.get(tag)}</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    font-size: 0.82rem;
  }
  .tags a {
    color: var(--fg-muted);
  }
  .tags a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .count {
    margin-left: 0.2rem;
    font-size: 0.75em;
    opacity: 0.7;
  }
  .count::before {
    content: '(';
  }
  .count::after {
    content: ')';
  }
</style>
