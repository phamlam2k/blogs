---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404" description="Page not found." noindex>
  <pre class="err"><code>$ cd {Astro.url.pathname}
bash: cd: {Astro.url.pathname}: no such page
<span class="accent">error code 404</span></code></pre>
  <p><a href="/">back home</a> · <a href="/search/">search</a></p>
</BaseLayout>

<style>
  .err {
    margin-top: 3rem;
    white-space: pre-wrap;
  }
</style>
