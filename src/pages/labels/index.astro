---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getTagCounts } from '../../utils/content';

const counts = await getTagCounts();
const max = Math.max(1, ...counts.values());
---

<BaseLayout title="Labels" description="All labels used on posts, repos and links on the blog.">
  <PageHeader command="grep -o '#[a-z-]*' -r . | sort | uniq -c" title="Labels" description={`${counts.size} labels`} />
  <ul class="cloud">
    {[...counts.entries()].map(([tag, n]) => (
      <li style={`--w:${0.85 + (n / max) * 0.5}rem`}>
        <a href={`/labels/${tag}/`}>#{tag}</a><span class="muted">{n}</span>
      </li>
    ))}
  </ul>
</BaseLayout>

<style>
  .cloud {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  li {
    font-size: var(--w);
  }
  span {
    font-size: 0.7em;
    margin-left: 0.2rem;
    vertical-align: super;
  }
</style>
