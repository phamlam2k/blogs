---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import LinkRow from '../components/LinkRow.astro';
import { getLinks } from '../utils/content';

const links = await getLinks();
---

<BaseLayout title="Links" description="Great articles and talks by other people, with a short note on why they're worth your time.">
  <PageHeader command="cat ./bookmarks" title="Links" description={`${links.length} links worth reading`} />
  {links.length === 0 ? <p class="muted">// no links yet</p> : <ul class="plain">{links.map((l) => <LinkRow link={l} />)}</ul>}
</BaseLayout>

<style>
  .plain {
    padding: 0;
    margin: 0;
  }
</style>
