---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, groupByYear } from '../../utils/content';

const posts = await getPosts();
const years = groupByYear(posts);
---

<BaseLayout title="All posts" description="Every post on the blog, grouped by year.">
  <PageHeader command="ls -lt ./posts" title="Posts" description={`${posts.length} posts`} />
  {
    years.map(([year, list]) => (
      <section>
        <h2 class="section-title">{year}</h2>
        <PostList posts={list} />
      </section>
    ))
  }
</BaseLayout>
