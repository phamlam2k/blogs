---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import RepoCard from '../components/RepoCard.astro';
import { getRepos } from '../utils/content';

const repos = await getRepos();
const mine = repos.filter((r) => r.data.mine);
const others = repos.filter((r) => !r.data.mine);
---

<BaseLayout title="Repos" description="GitHub repos I wrote or find worth checking out, with notes on why.">
  <PageHeader command="gh repo list --starred" title="Repos" description="My own repos and the ones worth bookmarking." />

  {mine.length > 0 && (
    <>
      <h2 class="section-title">mine</h2>
      <div class="grid">{mine.map((r) => <RepoCard repo={r} />)}</div>
    </>
  )}

  <h2 class="section-title">worth a look</h2>
  {others.length === 0 ? <p class="muted">// no repos yet</p> : <div class="grid">{others.map((r) => <RepoCard repo={r} />)}</div>}
</BaseLayout>

<style>
  .grid {
    display: grid;
    gap: 0.75rem;
  }
</style>
