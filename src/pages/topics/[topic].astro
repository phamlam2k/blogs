---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import RepoCard from '../../components/RepoCard.astro';
import LinkRow from '../../components/LinkRow.astro';
import TagList from '../../components/TagList.astro';
import { TOPICS, type TopicKey } from '../../consts';
import { getAll } from '../../utils/content';

export function getStaticPaths() {
  return (Object.keys(TOPICS) as TopicKey[]).map((topic) => ({ params: { topic } }));
}

const topic = Astro.params.topic as TopicKey;
const info = TOPICS[topic];
const all = await getAll();
const posts = all.posts.filter((p) => p.data.topic === topic);
const repos = all.repos.filter((r) => r.data.topic === topic);
const links = all.links.filter((l) => l.data.topic === topic);
const tags = [...new Set([...posts, ...repos, ...links].flatMap((x) => x.data.tags))].sort();
---

<BaseLayout title={`Topic: ${info.name}`} description={info.description}>
  <PageHeader command={`cd ./topics/${topic}`} title={info.name} description={info.description} />
  <TagList tags={tags} />

  <h2 class="section-title">posts ({posts.length})</h2>
  <PostList posts={posts} />

  {repos.length > 0 && (
    <>
      <h2 class="section-title">repos ({repos.length})</h2>
      <div class="grid">{repos.map((r) => <RepoCard repo={r} compact />)}</div>
    </>
  )}

  {links.length > 0 && (
    <>
      <h2 class="section-title">links ({links.length})</h2>
      <ul class="plain">{links.map((l) => <LinkRow link={l} compact />)}</ul>
    </>
  )}
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 0.75rem;
  }
  .plain {
    padding: 0;
    margin: 0;
  }
</style>
